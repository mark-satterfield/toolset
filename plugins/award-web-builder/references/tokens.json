      "lg":    { "value": "0 16px 48px rgba(0, 0, 0, 0.25)",        "type": "boxShadow" },
      "inset": { "value": "inset 0 0 20px -5px rgba(255, 255, 255, 0.4)", "type": "boxShadow" }
    },
    "radius": {
      "sm":   { "value": "12px",  "type": "borderRadius" },
