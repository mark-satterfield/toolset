{
  "$description": "Liquid Glass Design System tokens. Compatible with Style Dictionary and Tokens Studio.",
  "glass": {
    "blur": {
      "light":  { "value": "12px",  "type": "dimension", "description": "Subtle frosting" },
      "medium": { "value": "20px",  "type": "dimension", "description": "Standard glass blur" },
      "heavy":  { "value": "30px",  "type": "dimension", "description": "Maximum frosting for menus/modals" }
    },
    "background": {
      "light": {
        "light":  { "value": "rgba(255, 255, 255, 0.12)", "type": "color" },
        "medium": { "value": "rgba(255, 255, 255, 0.18)", "type": "color" },
        "heavy":  { "value": "rgba(255, 255, 255, 0.25)", "type": "color" }
      },
      "dark": {
        "light":  { "value": "rgba(255, 255, 255, 0.04)", "type": "color" },
        "medium": { "value": "rgba(255, 255, 255, 0.06)", "type": "color" },
        "heavy":  { "value": "rgba(255, 255, 255, 0.10)", "type": "color" }
      }
    },
    "saturation": { "value": "180%", "type": "other" },
    "brightness":  { "value": "1.05", "type": "other" },
    "border": {
