{
  "description": "Plugin hooks: the tier 1 main-worktree guard, the elaboration AWS CLI guard, the relay handoff check, the pipeline stop check, and the user-level agent sync.",
  "modules": [
    "./register.js"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-protect-main-worktree.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool-elaboration-aws-cli-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "Bash|StructuredOutput",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/portfolio/relayhandoff.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-user-agents.cjs\""
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-user-agents.cjs\""
          }
        ]
      }
    ]
  }
}
