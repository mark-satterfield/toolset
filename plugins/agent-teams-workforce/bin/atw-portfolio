#!/usr/bin/env bash
# Owner portfolio commands use the plugin's declared Python dependencies.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --no-project --python 3.14 --with 'typeguard>=4.4' --with 'jsonschema>=4.18' --with 'pyyaml>=6' \
  python -P "$here/../orchestrator/portfolio.py" "$@"
