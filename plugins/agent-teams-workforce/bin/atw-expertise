#!/usr/bin/env bash
# atw-expertise <match|text> ... — the skills that are expertise for an Epic's domains.
#   match [--resource-type T]... [--text-file F]   prints {"skills": [...]}: the skills whose own
#       front matter (expertiseFor: resourceTypes, terms) names one of the resource types or a
#       term found in the file. No table of skills exists outside the skills.
#   text NAME...   prints the text of the named skills, in the form a launched session is given.
#       A command that makes a skill newly needed while an agent works prints this as its output.
# orchestrator/core/skills.py is the command. It needs typeguard and PyYAML, which the python3 on
# PATH does not always have, so uv supplies them.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$here/..${PYTHONPATH:+:$PYTHONPATH}"
exec uv run --no-project --python 3.14 --with 'typeguard>=4.4' --with 'pyyaml>=6' \
  python -m orchestrator.core.skills "$@"
