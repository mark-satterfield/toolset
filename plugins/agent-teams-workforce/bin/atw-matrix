#!/usr/bin/env bash
# atw-matrix <sub-command> ... — reads and changes the matrix: one JSON file of entries (Epics,
# requirements, features, constraints, arc42 documents, services, components, infrastructure,
# events, stacks, packages, layers, disagreements) and the relationships between them, each with
# the side it came from (architecture or repository) and, where set, the verified mark.
#   reads:   epic, find, node, deps, stacks, layers, impact, related, uses, story-scope,
#            review-scope, summary, check, check-reuse, approval
#   tasks:   built, work, affected
#   changes: put, link, unlink, settle, rename, remove, move-repository, expertise, commit
#   syncs:   sync-epics, sync-documents
#   seeding: seed, seed-stacks, seed-packages, seed-inputs, seed-features, seed-apply
#   code:    verify
# `atw-matrix <sub-command> --help` lists a sub-command's options. scripts/portfolio/matrix.py is
# the command; the file's shape is skills/artifact-handoff/schemas/matrix.schema.json, and the
# kinds, and which role may run which sub-command, are
# skills/artifact-handoff/schemas/matrix-kinds.json. The role is the value of ATW_MATRIX_ROLE.
# Give the matrix file with --matrix, or set ATW_MATRIX, or set ATW_CONTROL_REPO and the file is
# ops/sdlc-automation/matrix.json under it. Prints one JSON object on stdout. The command needs
# typeguard, jsonschema and PyYAML (scripts/requirements.txt), which the python3 on PATH does not
# always have, so uv supplies them.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --no-project --python 3.14 --with 'typeguard>=4.4' --with 'jsonschema>=4.18' --with 'pyyaml>=6' \
  python -P "$here/../scripts/portfolio/matrix.py" "$@"
