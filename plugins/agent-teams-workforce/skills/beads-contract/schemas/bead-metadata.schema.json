{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-teams-workforce/skills/beads-contract/schemas/bead-metadata.schema.json",
  "title": "Pipeline-owned bead metadata",
  "description": "The one definition of every metadata key the pipeline writes on a bead (`bd show --json` .metadata), its value type, when it is required and its allowed values; plus the build-contract projection read_contract returns, the acceptance-criteria resolution result and the content fingerprint fields. Every value is stored as a string. scripts/generate_bead_metadata.py generates scripts/bead_metadata.py from this file; scripts/check_bead_metadata_generated.py fails when that module is stale.",
  "type": "object",
  "additionalProperties": {
    "type": "string"
  },
  "x-key-groups": [
    {
      "name": "CONTRACT_KEYS",
      "doc": "The build contract a Task carries."
    },
    {
      "name": "GATE_KEYS",
      "doc": "Keys the readiness gate (task-ready) writes."
    },
    {
      "name": "BUILD_LIFECYCLE_KEYS",
      "doc": "Keys the build lane writes on a Task."
    },
    {
      "name": "BUILD_STOP_KEYS",
      "doc": "Keys naming why a Task's build stopped; empty when it did not stop."
    },
    {
      "name": "CDS_AUDIT_KEYS",
      "doc": "The cds audit verdict of a web-ui Task."
    },
    {
      "name": "LANE_KEYS",
      "doc": "Keys the elaboration lane writes."
    },
    {
      "name": "ARTIFACT_KEYS",
      "doc": "Keys recording an authored document on its bead."
    },
    {
      "name": "STORY_KEYS",
      "doc": "Keys on a Story: its owned edges and the host's record of its deploy."
    },
    {
      "name": "WSJF_KEYS",
      "doc": "Keys WSJF scoring writes; numeric values are stored as text."
    },
    {
      "name": "SEQUENCING_KEYS",
      "doc": "Keys dependency assessment writes."
    }
  ],
  "x-constants": [
    {
      "name": "UNKNOWN",
      "value": "unknown",
      "doc": "The literal a producer writes for an undecided -or-unknown contract value; read as None."
    },
    {
      "name": "ACCEPTANCE_FIELD",
      "value": "acceptance_criteria",
      "doc": "The record field `bd create/update --acceptance` writes."
    },
    {
      "name": "SOURCE_METADATA",
      "value": "metadata.acceptance_criteria",
      "doc": "Criteria source 1: the bead's acceptance_criteria metadata key."
    },
    {
      "name": "SOURCE_ACCEPTANCE",
      "value": "acceptance_criteria",
      "doc": "Criteria source 2: the bead's acceptance_criteria record field."
    },
    {
      "name": "SOURCE_DESCRIPTION",
      "value": "description",
      "doc": "Criteria source 3: the bead's description."
    },
    {
      "name": "CONTENT_HASH_LENGTH",
      "value": 16,
      "doc": "Hex characters kept from the SHA-256 of the fingerprint payload."
    }
  ],
