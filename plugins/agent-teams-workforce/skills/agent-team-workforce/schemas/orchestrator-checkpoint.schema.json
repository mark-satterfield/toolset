{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema.skillspoke.com/agent-team-workforce/orchestrator-checkpoint.json",
  "title": "Orchestrator Checkpoint",
  "description": "Written by the orchestrator to ratify peer consensus. The orchestrator reads all peer review verdicts, spot-checks artifacts, and decides whether to approve or send workers back for remediation. Domain-agnostic.",
  "type": "object",
  "properties": {

    "teamId": { "type": "string" },
    "checkpointNumber": { "type": "integer", "minimum": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "orchestratorId": { "type": "string" },

    "workerReviews": {
      "type": "array",
      "description": "One entry per worker reviewed in this checkpoint.",
      "items": {
        "type": "object",
        "properties": {

          "workerId": { "type": "string" },
          "iterationReviewed": { "type": "integer" },

          "spotCheckResults": {
            "type": "object",
            "description": "Orchestrator's spot-check of a sample of this worker's artifacts and claims.",
            "properties": {
              "artifactsSampled": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "claimedHash": { "type": "string" },
                    "actualHash": { "type": "string" },
                    "exists": { "type": "boolean" },
                    "hashMatch": { "type": "boolean" },
                    "notes": { "type": "string" }
                  },
                  "required": ["path", "exists"]
                }
              },
              "testsSampled": {
                "type": "array",
                "description": "Tests the orchestrator re-ran to verify.",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "command": { "type": "string" },
                    "passed": { "type": "boolean" },
                    "notes": { "type": "string" }
                  },
                  "required": ["name", "passed"]
                }
              },
              "spotCheckVerdict": { "type": "string", "enum": ["PASS", "FAIL", "PASS_WITH_NOTES"] },
              "issues": { "type": "array", "items": { "type": "string" } }
            }
          },

          "peerCrossReviewSummary": {
            "type": "object",
            "description": "Summary of cross-reviews this worker received from peer workers.",
            "properties": {
              "reviewsReceived": { "type": "integer" },
              "reviewsExpected": { "type": "integer" },
              "verdicts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "peerWorkerId": { "type": "string", "description": "The worker who performed this review." },
                    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "PASS_WITH_NOTES"] }
                  },
                  "required": ["peerWorkerId", "verdict"]
                }
              },
              "allPeersPassed": { "type": "boolean" }
            }
          },

          "workerVerdict": {
            "type": "string",
            "enum": ["APPROVED", "NEEDS_REMEDIATION", "ESCALATE_TO_USER"],
            "description": "Orchestrator's final decision. APPROVED = peer consensus ratified. NEEDS_REMEDIATION = orchestrator disagrees or spot-check failed."
          },

          "remediationInstructions": {
            "type": "array",
            "description": "Written to the worker's assignment file if verdict is NEEDS_REMEDIATION.",
            "items": {
              "type": "object",
              "properties": {
                "issue": { "type": "string" },
                "requiredAction": { "type": "string" },
                "severity": { "type": "string", "enum": ["blocking", "major", "minor"] }
              },
              "required": ["issue", "requiredAction", "severity"]
            }
          }
        },
        "required": ["workerId", "workerVerdict"]
      }
    },

    "consensusState": {
      "type": "object",
      "properties": {
        "round": { "type": "integer" },
        "allWorkersApproved": { "type": "boolean" },
        "remainingIssues": { "type": "array", "items": { "type": "string" } }
      }
    },

    "nextAction": {
      "type": "string",
      "enum": ["continue-remediation", "write-final-approval", "escalate-to-user"]
    },

    "orchestratorNotes": { "type": "string" }
  },

  "required": [
    "teamId", "checkpointNumber", "reviewedAt",
    "orchestratorId", "workerReviews", "nextAction"
  ]
}
