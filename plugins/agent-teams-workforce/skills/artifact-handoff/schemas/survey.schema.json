{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "survey.json",
  "description": "The architecture survey an Epic's prd-reality-reconciler saves as survey.json in the Epic work directory. This file is the one definition of the survey and of the architecture baseline ($defs/Baseline). skills/artifact-handoff/survey_contract.py is generated from it by scripts/gen_survey_contract.py; never restate a field or value elsewhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "subjectReason",
    "capabilities",
    "baseline",
    "openTargets",
    "businessConflicts",
    "coverage",
    "summary"
  ],
  "properties": {
    "subject": {
      "description": "the feature, service, component or layer this PRD changes, which the target will describe, named as the glossary and the repositories name it — never the PRD, the Epic, a bead id or a date. Give the name as it is written (`Company Intelligence` and `company-intelligence` are both fine): the run derives the `target/<subject>/` folder name from it (lower-case, every run of other characters one hyphen).",
      "type": "string"
    },
    "subjectReason": {
      "description": "why that is the subject.",
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      }
    },
    "baseline": {
      "$ref": "#/$defs/Baseline"
    },
    "openTargets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "businessConflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BusinessConflict"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CoverageRow"
      }
    },
    "summary": {
      "type": "string"
    }
  },
  "$defs": {
    "EvidenceRef": {
      "description": "One piece of evidence. Every field is present; a field the reference does not use is the empty string.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "heading",
        "repo",
        "revision",
        "url"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "Capability": {
      "description": "One capability the PRD needs. Its name equals the id of a baseline entry, and its requirements agree with that entry's requirements.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "requirements",
        "effectiveViews",
        "code",
        "openBeads",
        "openTargets"
      ],
      "properties": {
        "name": {
          "description": "the capability's name, the id of its baseline entry.",
          "type": "string"
        },
        "requirements": {
          "description": "the PRD requirement headings it serves.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effectiveViews": {
          "description": "the absolute paths of the effective views (under arc42/) that show it, found through the catalog.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code": {
          "description": "the code that implements it on `main`, as `<repo>:<path>:<line>`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openBeads": {
          "description": "the ids of open Stories and Tasks of other Epics that plan work on it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "openTargets": {
          "description": "the paths of open targets under the architecture's target/ folder that change it.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "description": "where you looked when a list is empty (an empty list is an answer), the result of the architecture-baseline skill's check of what the effective architecture does not yet represent with the documents checked, and on a recheck why the evidence refutes a finding.",
          "type": "string"
        }
      }
    },
    "BusinessConflict": {
      "description": "Two or more business requirements of the PRD that no design can satisfy together, and why.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "why"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        }
      }
    },
    "CoverageStatus": {
      "description": "How far the architecture covers one obligation. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "Present and sufficient",
        "Present but incomplete",
        "Required and absent",
        "Not yet applicable",
        "Not assessed"
      ],
      "default": "Not assessed"
    },
    "CoverageAction": {
      "description": "What the change does to the views covering one obligation. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "create",
        "update",
        "unchanged",
        "remove",
        "not-applicable",
        "unresolved"
      ],
      "default": "unresolved"
    },
    "CoverageDisposition": {
      "description": "Whether a coverage row is required by this change or unrelated historical debt. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "required",
        "unrelated-debt"
      ],
      "default": "required"
    },
    "CoverageRow": {
      "description": "One obligation of the architecture documentation model and how the architecture covers it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "scope",
        "obligation",
        "sources",
        "views",
        "status",
        "action",
        "reason",
        "evidenceRefs",
        "disposition",
        "dispositionReason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "obligation": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "action": {
          "$ref": "#/$defs/CoverageAction"
        },
        "reason": {
          "type": "string"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "disposition": {
          "$ref": "#/$defs/CoverageDisposition"
        },
        "dispositionReason": {
          "type": "string"
        }
      }
    },
    "CoverageStatusAction": {
      "description": "Rule: the coverage action a status requires. A consumer derives the action from the status for each pair listed.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "action"
          ],
          "properties": {
            "status": {
              "const": "Not yet applicable"
            },
            "action": {
              "const": "not-applicable"
            }
          }
        }
      ]
    },
    "UnrelatedDebtReason": {
      "description": "Rule: a coverage row whose disposition is unrelated-debt carries a non-empty dispositionReason; a consumer reads a row that breaks it as the default disposition.",
      "type": "object",
      "if": {
        "properties": {
          "disposition": {
            "const": "unrelated-debt"
          }
        }
      },
      "then": {
        "properties": {
          "dispositionReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "DocumentVersion": {
      "description": "Which version of the architecture a cited document belongs to. A consumer reads a missing value as the default.",
      "type": "string",
      "enum": [
        "effective",
        "target",
        "delta",
        "built"
      ],
      "default": "effective"
    },
    "DocumentLifecycleState": {
      "description": "The lifecycle_state a cited document carries. A consumer reads a missing value as the default.",
      "type": "string",
      "enum": [
        "effective",
        "in-review"
      ],
      "default": "in-review"
    },
    "BaselineDocument": {
      "description": "One architecture document a baseline entry cites.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "version",
        "lifecycle_state"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/DocumentVersion"
        },
        "lifecycle_state": {
          "$ref": "#/$defs/DocumentLifecycleState"
        }
      }
    },
    "CodeState": {
      "description": "How completely the code on main implements a capability. A consumer reads a missing value as the default.",
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "absent",
        "unknown",
        "not-applicable"
      ],
      "default": "unknown"
    },
    "BaselineCode": {
      "description": "The code evidence of one baseline entry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "behaviorEvidenceRefs",
        "infrastructureEvidenceRefs"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/CodeState"
        },
        "behaviorEvidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "infrastructureEvidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        }
      }
    },
    "BaselineKind": {
      "description": "What a baseline entry assesses. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "behavior",
        "infrastructure",
        "documentation"
      ],
      "default": "behavior"
    },
    "DesignAction": {
      "description": "What the design does for a baseline entry. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "none",
        "reuse",
        "validate-existing",
        "modify",
        "new"
      ],
      "default": "validate-existing"
    },
    "DocumentationAction": {
      "description": "What the documentation does for a baseline entry. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "none",
        "update",
        "create"
      ],
      "default": "none"
    },
    "ImplementationAction": {
      "description": "What the implementation does for a baseline entry. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "none",
        "modify",
        "new",
        "replace",
        "retire",
        "unknown"
      ],
      "default": "unknown"
    },
    "BaselineDisposition": {
      "description": "Implementation disposition from assessed current behavior to the required target; existing code is evidence, never an obligation to retain it. A consumer reads an invalid value as the default.",
      "type": "string",
      "enum": [
        "retain",
        "change",
        "replace",
        "add",
        "retire",
        "undetermined"
      ],
      "default": "undetermined"
    },
    "BaselineEntry": {
      "description": "One capability's assessment: its id equals a capability name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "requirements",
        "subjects",
        "documents",
        "code",
        "awsGuidance",
        "designAction",
        "documentationAction",
        "implementationAction",
        "rationale",
        "conflicts",
        "current",
        "target",
        "disposition",
        "suitabilityEvidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/BaselineKind"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BaselineDocument"
          }
        },
        "code": {
          "$ref": "#/$defs/BaselineCode"
        },
        "awsGuidance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          }
        },
        "designAction": {
          "$ref": "#/$defs/DesignAction"
        },
        "documentationAction": {
          "$ref": "#/$defs/DocumentationAction"
        },
        "implementationAction": {
          "$ref": "#/$defs/ImplementationAction"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "current": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "$ref": "#/$defs/BaselineDisposition"
        },
        "suitabilityEvidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1
        }
      }
    },
    "Baseline": {
      "description": "The architecture baseline: the survey's baseline array.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/BaselineEntry"
      }
    },
    "FreshBaselineEntry": {
      "description": "Rule: the survey agent writes every fresh baseline entry with these values; it judges design and documentation, never built-ness.",
      "type": "object",
      "required": [
        "code",
        "implementationAction",
        "disposition"
      ],
      "properties": {
        "code": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unknown"
            }
          }
        },
        "implementationAction": {
          "const": "unknown"
        },
        "disposition": {
          "const": "undetermined"
        }
      }
    },
    "DispositionImplementationAction": {
      "description": "Rule: the implementation action each baseline disposition implies.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "disposition",
            "implementationAction"
          ],
          "properties": {
            "disposition": {
              "const": "retain"
            },
            "implementationAction": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "implementationAction"
          ],
          "properties": {
            "disposition": {
              "const": "change"
            },
            "implementationAction": {
              "const": "modify"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "implementationAction"
          ],
          "properties": {
            "disposition": {
              "const": "replace"
            },
            "implementationAction": {
              "const": "replace"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "implementationAction"
          ],
          "properties": {
            "disposition": {
              "const": "add"
            },
            "implementationAction": {
              "const": "new"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "implementationAction"
          ],
          "properties": {
            "disposition": {
              "const": "retire"
            },
            "implementationAction": {
              "const": "retire"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "disposition",
            "implementationAction"
          ],
          "properties": {
            "disposition": {
              "const": "undetermined"
            },
            "implementationAction": {
              "const": "unknown"
            }
          }
        }
      ]
    },
    "CodeStateImplementationAction": {
      "description": "Rule: the implementation action code in each listed state needs when the disposition implies none.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "implementationAction"
          ],
          "properties": {
            "state": {
              "const": "partial"
            },
            "implementationAction": {
              "const": "modify"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "implementationAction"
          ],
          "properties": {
            "state": {
              "const": "absent"
            },
            "implementationAction": {
              "const": "new"
            }
          }
        }
      ]
    }
  }
}
