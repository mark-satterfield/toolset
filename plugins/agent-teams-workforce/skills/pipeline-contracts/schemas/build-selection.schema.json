{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Build specialist selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["agents", "rationale"],
  "properties": {
    "agents": {
      "description": "Bare roster agent names without a plugin prefix. An empty list selects no specialists.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
    },
    "rationale": {"type": "string", "minLength": 1}
  }
}
