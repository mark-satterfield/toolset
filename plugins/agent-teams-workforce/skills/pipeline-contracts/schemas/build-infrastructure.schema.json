    "resources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["logicalId", "type", "stack", "properties"], "properties": {"logicalId": {"type": "string"}, "type": {"type": "string"}, "stack": {"type": "string"}, "properties": {"type": "string"}}}},
