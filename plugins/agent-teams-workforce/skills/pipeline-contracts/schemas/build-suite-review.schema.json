{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Suite quality and failure judgment",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "coverage", "evidence"],
  "properties": {
    "route": {"enum": ["pass", "test-repair", "implementation", "environment"]},
    "coverage": {"type": "string", "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "suiteEvidence": {"type": "string", "minLength": 1}
  },
  "allOf": [{"if": {"properties": {"route": {"const": "pass"}}}, "then": {"required": ["suiteEvidence"]}}]
}
